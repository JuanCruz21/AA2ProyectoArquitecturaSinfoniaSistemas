# Copie este archivo como `.env` y ajuste los valores.
#   cp .env.example .env

# --- Aplicacion ---
APP_NAME="LabCloud API"
DEBUG=True

# --- Base de datos ---
# SQLite para desarrollo. Para PostgreSQL seria, por ejemplo:
#   DATABASE_URL="postgresql+psycopg://usuario:clave@localhost:5432/labcloud"
DATABASE_URL="sqlite:///./labcloud.db"

# --- Seguridad ---
# IMPORTANTE: genere una clave propia antes de desplegar la aplicacion.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="cambie-esta-clave-por-una-generada-aleatoriamente"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
MIN_PASSWORD_LENGTH=8

# --- CORS ---
# Origenes autorizados. Admite JSON o valores separados por comas.
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
